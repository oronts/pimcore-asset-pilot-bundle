{
  "name": "pimcore-studio-asset-pilot-bundle",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10.9 <12"
  },
  "scripts": {
    "dev": "NODE_ENV=development rsbuild build",
    "dev-server": "NODE_ENV=dev-server rsbuild dev",
    "build": "node scripts/publish-build.mjs",
    "prepare-release-build": "node scripts/prepare-release-build.mjs",
    "build:bundle": "rsbuild build",
    "check-types": "tsc --noEmit",
    "lint": "eslint js/src js/test scripts rsbuild.config.ts vitest.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:a11y": "vitest run js/test/accessibility",
    "test:watch": "vitest",
    "verify-build": "node scripts/verify-build.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@module-federation/rsbuild-plugin": "^2.7.0",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react-dom": "18.3.x",
    "@types/webpack-env": "^1.18.4",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@pimcore/studio-ui-bundle": "2025.4.8",
    "antd": "5.22.x",
    "i18next": "^23.16.8",
    "react": "18.3.x",
    "react-dom": "18.3.x",
    "react-i18next": "^14.1.3"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "uuid": "^11.1.1"
  },
  "assetPilotBuild": {
    "maxJavaScriptChunkBytes": 1600000,
    "maxJavaScriptChunkGzipBytes": 500000,
    "budgetRationale": "Allows the required Pimcore Studio and Ant Design shared fallback chunk with limited growth headroom."
  }
}
