{
    "name": "oronts/asset-pilot-bundle",
    "description": "Intelligent rule-based asset organization engine for Pimcore 12 with expression language conditions, pluggable strategies, async processing, and Studio UI integration.",
    "type": "pimcore-bundle",
    "license": "AGPL-3.0-or-later",
    "keywords": ["pimcore", "assets", "organization", "automation", "pimcore-12", "studio-ui"],
    "authors": [
        {
            "name": "Oronts",
            "email": "dev@oronts.com",
            "homepage": "https://oronts.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "pimcore/pimcore": "^12.0",
        "symfony/expression-language": "^7.0",
        "symfony/messenger": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.50"
    },
    "autoload": {
        "psr-4": {
            "Oronts\\AssetPilotBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oronts\\AssetPilotBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "pimcore": {
            "bundles": [
                "Oronts\\AssetPilotBundle\\OrontsAssetPilotBundle"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
